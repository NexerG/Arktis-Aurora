<?xml version="1.0" encoding="utf-8"?>
<ContextMenu>
	<ContextButton Text="Cut" Action="Text.Cut"/>
	<ContextButton Text="Copy" Action="Text.Copy"/>
	<ContextButton Text="Paste" Action="Sheet.PasteLink"/>
	<ContextLine/>
	<ContextButton Text="Encrypt blocks..." Action="Notes.EncryptBlocks"/>
	<ContextLine/>
	<ContextButton Text="Insert formula" Action="Math.Insert"/>
	<ContextButton Text="Insert display formula" Action="Math.InsertDisplay"/>
	<ContextButton Text="Edit formula" Action="Math.Edit" When="formula-selected"/>
	<ContextLine/>
	<ContextButton Text="Insert table" Action="Table.Insert" When="outside-table"/>
	<ContextButton Text="Insert table of contents" Action="Toc.Insert" When="outside-table"/>
	<ContextSubmenu Text="Table" When="table-cell">
		<ContextButton Text="Insert row above" Action="Table.RowAbove"/>
		<ContextButton Text="Insert row below" Action="Table.RowBelow"/>
		<ContextButton Text="Insert column left" Action="Table.ColumnLeft"/>
		<ContextButton Text="Insert column right" Action="Table.ColumnRight"/>
		<ContextLine/>
		<ContextButton Text="Merge cell right" Action="Table.MergeRight"/>
		<ContextButton Text="Split cell" Action="Table.Split"/>
		<ContextLine/>
		<ContextButton Text="Delete row" Action="Table.DeleteRow"/>
		<ContextButton Text="Delete column" Action="Table.DeleteColumn"/>
		<ContextButton Text="Delete table" Action="Table.Delete"/>
	</ContextSubmenu>
	<ContextLine/>
	<ContextSubmenu Text="List marker">
		<ContextButton Text="Filled circle" Action="List.Disc"/>
		<ContextButton Text="Empty circle" Action="List.Circle"/>
		<ContextButton Text="Filled triangle" Action="List.Triangle"/>
		<ContextButton Text="Empty triangle" Action="List.TriangleOutline"/>
		<ContextButton Text="Filled square" Action="List.Square"/>
		<ContextButton Text="Empty square" Action="List.SquareOutline"/>
		<ContextLine/>
		<ContextButton Text="1. 2. 3." Action="List.Decimal"/>
		<ContextButton Text="A. B. C." Action="List.UpperAlpha"/>
		<ContextButton Text="a. b. c." Action="List.LowerAlpha"/>
		<ContextButton Text="i. ii. iii." Action="List.LowerRoman"/>
		<ContextButton Text="I. II. III." Action="List.UpperRoman"/>
		<ContextLine/>
		<ContextButton Text="Continue numbering" Action="List.ContinueNumbering"/>
	</ContextSubmenu>
	<ContextSubmenu Text="Wrap text" When="picture-selected">
		<ContextButton Text="In line with text" Action="Picture.WrapInline"/>
		<ContextButton Text="Square" Action="Picture.WrapSquare"/>
		<ContextButton Text="Tight" Action="Picture.WrapTight"/>
		<ContextButton Text="Top and bottom" Action="Picture.WrapTopAndBottom"/>
		<ContextButton Text="Behind text" Action="Picture.WrapBehind"/>
		<ContextButton Text="In front of text" Action="Picture.WrapInFront"/>
	</ContextSubmenu>
	<ContextSubmenu Text="Collision" When="picture-selected">
		<ContextButton Text="Bounding box" Action="Picture.CollideBox"/>
		<ContextButton Text="Picture shape" Action="Picture.CollideShape"/>
	</ContextSubmenu>
</ContextMenu>
