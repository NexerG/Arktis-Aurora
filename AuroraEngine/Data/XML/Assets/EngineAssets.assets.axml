<AssetManifest xmlns="http://arctisaurora/AuroraAssetRegistryTypes"
			   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			   xsi:schemaLocation="http://arctisaurora/AuroraAssetRegistryTypes ../Schemas/AssetRegistryTypeSchema.xsd">

	<Asset Type="AVulkanMesh"  Name="uidefault" Source="Meshes/uiquad.fbx"/>

	<Asset Type="TextureAsset" Name="default"   Source="UIMasks/defaultMask.png"/>
	<Asset Type="TextureAsset" Name="invisible" Source="UIMasks/invisibleMask.png"/>

	<Asset Type="FontAsset"    Name="default"   Source="Fonts/arial"/>
	<Asset Type="FontAsset"    Name="arial-b"     Source="Fonts/arialbd"/>
	<Asset Type="FontAsset"    Name="electrolize" Source="Fonts/Electrolize-Regular"/>
	<Asset Type="FontAsset"    Name="consola"     Source="Fonts/consola"/>
	<Asset Type="FontAsset"    Name="math"        Source="Fonts/cambria"/>
	<!-- Latin Modern, baked from _Build/FontSources -->
	<Asset Type="FontAsset" Name="latin-modern"      Source="Fonts/lmroman10-regular"/>
	<Asset Type="FontAsset" Name="latin-modern-mono" Source="Fonts/lmmono10-regular"/>
	<Asset Type="FontAsset" Name="latin-modern-mono-12" Source="Fonts/lmmono12-regular"/>
	<Asset Type="FontAsset" Name="latin-modern-math" Source="Fonts/latinmodern-math"/>
	<!-- TeX Gyre Termes, the Times of mathptmx and kin, baked from _Build/FontSources -->
	<Asset Type="FontAsset" Name="tex-gyre-termes"   Source="Fonts/texgyretermes-regular"/>
	<!-- Carlito, metric-compatible with Calibri, baked from _Build/FontSources -->
	<Asset Type="FontAsset" Name="carlito"           Source="Fonts/Carlito-Regular"/>

	<Asset Type="IconSetAsset" Name="default"   Source="Icons/default"/>

	<Asset Type="UIDocumentAsset" Name="settings" Source="XML/Documents/UI/Settings.ui.axml"/>

	<!-- context menus on the new stack, named by a control's ContextMenu attribute -->
	<Asset Type="ContextMenuAsset" Name="view" Source="XML/Documents/Menus/View.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="tab"  Source="XML/Documents/Menus/Tab.menu.axml"/>

</AssetManifest>
