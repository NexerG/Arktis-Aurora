<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Arctis.Imaging</AssemblyName>
    <RootNamespace>Arctis.Imaging</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Arctis.Imaging</PackageId>
    <Version>0.1.0</Version>
    <Authors>NexerG</Authors>
    <Description>Image decoding and encoding for .NET that writes pixels straight into caller-owned memory, such as a mapped GPU staging buffer.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>image;png;bmp;decoder;encoder;vulkan;gamedev</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Arctis.Imaging.Tests" />
  </ItemGroup>
</Project>
